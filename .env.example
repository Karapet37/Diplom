# Persona-Graph Agent System
# Copy to `.env.local` for local work or `.env` for simple setups.

# Runtime profile and entrypoint
COGNITIVE_RUNTIME_PROFILE=development
WEB_HOST=127.0.0.1
WEB_PORT=8008

# Paths are repo-relative unless made absolute.
COGNITIVE_MEMORY_ROOT=memory
COGNITIVE_WEBAPP_DIR=webapp
COGNITIVE_WEBAPP_DIST_DIR=webapp/dist
LOCAL_MODELS_DIR=models/gguf

# Local GGUF role paths. Leave empty to use LOCAL_MODELS_DIR autodiscovery.
LOCAL_GGUF_MODEL=
LOCAL_ANALYST_GGUF_MODEL=
LOCAL_TRANSLATOR_GGUF_MODEL=
LOCAL_CREATIVE_GGUF_MODEL=
LOCAL_PLANNER_GGUF_MODEL=
LOCAL_CODER_ARCHITECT_GGUF_MODEL=
LOCAL_CODER_REVIEWER_GGUF_MODEL=
LOCAL_CODER_REFACTOR_GGUF_MODEL=
LOCAL_CODER_DEBUG_GGUF_MODEL=

# Optional role-specific contexts.
LOCAL_GGUF_N_CTX=2048
LOCAL_ANALYST_N_CTX=2048
LOCAL_TRANSLATOR_N_CTX=2048
LOCAL_LLM_RETRY_ROUNDS=1
LOCAL_LLM_FAST_CONTEXT_ATTEMPTS=1
LOCAL_LLM_MAX_CONTEXT_ATTEMPTS=2

# Route the main chat/extraction/persona generation through the general model,
# and keep the analyst model for reviewer / rethink passes.
COGNITIVE_CHAT_ROLE=general
COGNITIVE_EXTRACTION_ROLE=general
COGNITIVE_PERSONA_ROLE=general
COGNITIVE_RETHINK_ROLE=analyst

# Chat orchestration strategies:
# - primary_with_reviewer: primary model drafts, reviewer checks on failure or always
# - single: one model only
# - alternate: primary and reviewer swap by turn
# - randomized: primary and reviewer swap deterministically per request
COGNITIVE_CHAT_ORCHESTRATION=primary_with_reviewer
COGNITIVE_CHAT_PRIMARY_ROLE=general
COGNITIVE_CHAT_REVIEW_ROLE=analyst
# Review modes:
# - on_failure: reviewer only repairs route/style/validation failures
# - always: reviewer rewrites every successful draft too
COGNITIVE_CHAT_REVIEW_MODE=always

# Core runtime budgets and behavior.
COGNITIVE_MAX_CONTEXT_TOKENS=3200
COGNITIVE_PERSONA_BLOCK_BUDGET=900
COGNITIVE_GRAPH_CONTEXT_BUDGET=1100
COGNITIVE_RECENT_DIALOGUE_BUDGET=320
COGNITIVE_GRAPH_SUBGRAPH_LIMIT=8
COGNITIVE_BACKGROUND_REBUILD_INTERVAL=6
COGNITIVE_ENABLE_FRONTEND_ROOT=1
COGNITIVE_ENABLE_FRONTEND_ASSETS=1
COGNITIVE_ENABLE_BACKGROUND_REBUILD=1
COGNITIVE_ENABLE_CONCEPT_GRAPH_PREMERGE=1
COGNITIVE_INCLUDE_SIDE_EFFECTS=1

# Optional separate frontend build base when serving frontend elsewhere.
# VITE_API_BASE_URL=
